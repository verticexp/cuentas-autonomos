{
  "appId": "com.fisquo.app",
  "appName": "Fisquo",
  "webDir": "www",
  "server": {
    "url": "https://www.fisquo.com",
    "allowNavigation": [
      "www.fisquo.com",
      "fisquo.com"
    ],
    "errorPath": "sin-conexion.html"
  },
  "ios": {
    "appendUserAgent": "FisquoApp/1",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true,
    "backgroundColor": "#0F1F1B",
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "android": {
    "appendUserAgent": "FisquoApp/1",
    "backgroundColor": "#0F1F1B"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#0F1F1B",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
